{
  "name": "pingis",
  "displayName": "Pingis",
  "description": "Two-agent (Executor + Critic) development assistant for VS Code. Launches its own pair of DeepSeek Automation API servers, keeps agents in isolated chats, manages the full lifecycle, tracks context, and uses a plan.md protocol for long tasks.",
  "version": "0.3.4",
  "publisher": "maresin",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/maresin/pingis.git"
  },
  "bugs": {
    "url": "https://github.com/maresin/pingis/issues"
  },
  "homepage": "https://github.com/maresin/pingis#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:pingis.panel",
    "onCommand:pingis.start",
    "onCommand:pingis.showLogs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pingis",
          "title": "Pingis",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pingis": [
        {
          "type": "webview",
          "id": "pingis.panel",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "pingis.start",
        "title": "DeepSeek: Start task"
      },
      {
        "command": "pingis.showLogs",
        "title": "DeepSeek: Show logs"
      }
    ],
    "configuration": {
      "title": "Pingis",
      "properties": {
        "pingis.apiDir": {
          "type": "string",
          "default": "",
          "description": "Path to your clone of deepseek-automation-api. Pingis builds the multi-agent deployment (~/.pingis/deepseek-agents/) itself from this clone and manages the agents automatically."
        },
        "pingis.taskTimeoutMinutes": {
          "type": "number",
          "default": 120,
          "description": "Maximum task duration in minutes."
        },
        "pingis.execTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "description": "Timeout for a single execute script, in seconds. Increase for tasks with npm install or cargo build."
        },
        "pingis.saveRawResponses": {
          "type": "boolean",
          "default": false,
          "description": "Save raw JSON API responses to .pingis/raw/. Debug only — files accumulate fast."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "vscode:prepublish": "npm run compile",
    "probe:409": "ts-node --project scripts/tsconfig.json scripts/probe-409.ts",
    "probe:help": "ts-node --project scripts/tsconfig.json scripts/probe-help.ts",
    "probe:help-protocol": "ts-node --project scripts/tsconfig.json scripts/probe-help-protocol.ts",
    "probe:exec": "ts-node --project scripts/tsconfig.json scripts/probe-exec.ts",
    "probe:artifacts": "ts-node --project scripts/tsconfig.json scripts/probe-artifacts.ts",
    "probe:retry": "ts-node --project scripts/tsconfig.json scripts/probe-retry.ts",
    "probe:phase": "ts-node --project scripts/tsconfig.json scripts/probe-phase.ts",
    "probe:return-to-original": "ts-node --project scripts/tsconfig.json scripts/probe-return-to-original.ts",
    "probe:format-budget": "ts-node --project scripts/tsconfig.json scripts/probe-format-budget.ts",
    "probe:context-transition": "ts-node --project scripts/tsconfig.json scripts/probe-context-transition.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "systeminformation": "^5.22.0"
  },
  "icon": "media/icon-marketplace.png",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "deepseek",
    "code-generation",
    "code-review",
    "two-agent",
    "multi-agent",
    "automation"
  ]
}
